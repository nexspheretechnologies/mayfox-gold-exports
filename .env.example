# Public site origin. Drives canonical URLs, og:url, sitemap and JSON-LD ids.
SITE_URL=https://mayfox.co.ke
VITE_SITE_URL=https://mayfox.co.ke

# Supabase (project settings -> API). Server-side values.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Required: the lead store writes and reads through this service-role key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Client-side Supabase values (VITE_ prefix is embedded in the browser bundle).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Resend transactional email. Verify the sending domain in the Resend dashboard first.
RESEND_API_KEY=re_...
RESEND_FROM=Mayfox Trade Desk <leads@mayfox.co.ke>
LEAD_NOTIFY_EMAIL=sales@mayfox.co.ke

# Comma-separated allowlist permitted to read the trade-desk inbox at /admin/leads.
LEAD_STAFF_EMAILS=sales@mayfox.co.ke

# Salt for the hashed visitor IP used in submission rate limiting.
IP_HASH_SALT=change-me

# Optional integrations; leave blank to hide the feature.
VITE_GA_ID=                        # Google Analytics 4 measurement id, e.g. G-XXXXXXXXXX
VITE_CAL_URL=                      # Cal.com / Zoom scheduling link embedded at /book-a-call
VITE_WHATSAPP_NUMBER=254754979755

# Private Supabase Storage bucket for buyer KYC uploads at /upload-documents.
# Create it by applying supabase/migrations/0002_kyc_documents.sql, or leave the
# default name and the migration's bucket insert handles it.
KYC_BUCKET=kyc-documents
